# Names only. Copy to apps/web/.env, services/analyzer/.env and agents/.env and fill in. Never commit real values.

# apps/web
DATABASE_URL=postgres://validate:validate@localhost:5433/validate_ai
ANALYZER_URL=http://localhost:8000
ANALYZER_KEY=
SESSION_SECRET=
# Audio input (record + upload). Off: the upload form is text only and /api/transcribe is a 404.
AUDIO_INPUT_ENABLED=false
# Defaults 100 and 60 when empty. Keep AUDIO_MAX_MB the same in apps/web and services/analyzer.
AUDIO_MAX_MB=
AUDIO_MAX_MINUTES=

# services/analyzer
ANALYZER_KEY=
TYPESAFE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
# Audio transcription (ElevenLabs Scribe). Only the analyzer holds this key; the browser never sees it.
ELEVENLABS_API_KEY=
# Defaults to scribe_v2 when empty.
ELEVENLABS_STT_MODEL=
AUDIO_MAX_MB=

# agents (hackathon). Copy this section to agents/.env. See agents/README.md.
AGENT_SEED_FRONT=
AGENT_SEED_INTAKE=
AGENT_SEED_ANALYST=
AGENT_SEED_STRATEGIST=
AGENT_SEED_TESTER=
# 1: the front agent chains Intake -> Signal Analyst -> Strategist. 0: it runs the pipeline itself.
FRONT_USE_SPECIALISTS=1
# The agents import the analyzer pipeline, so they need the same keys as services/analyzer:
# TYPESAFE_API_KEY, OPENAI_API_KEY, OPENAI_MODEL
AGENTVERSE_API_KEY=
# Price in FET (Fetch testnet) of the sentence-by-sentence breakdown. Empty: payments off, breakdown free.
PAYMENT_FET_AMOUNT=

# web chat with the agents. Same AGENT_CHAT_KEY in apps/web/.env and agents/.env.
# AGENT_URL (apps/web only) is the front agent's own address, e.g. http://localhost:8001
AGENT_URL=
AGENT_CHAT_KEY=
# Optional (apps/web only): the front agent's Agentverse page. Shown as a link in the chat window.
NEXT_PUBLIC_AGENT_PROFILE_URL=
