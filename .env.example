# Copy to .env (git-ignored). One .env at the repo root serves every service.
# Never commit real values.

# --- Web (apps/web): the only service that connects to Postgres
DATABASE_URL=postgres://realsignal:realsignal@localhost:5432/realsignal

# --- Analyzer (services/analyzer): private, called by the web app and the agents
ANALYZER_URL=http://localhost:8000
# Shared secret sent as X-Analyzer-Key. Generate with: openssl rand -hex 32
ANALYZER_SECRET=
# Set to 1 to run with fake AI clients (no keys, no paid calls). Leave empty for real analysis.
ANALYZER_FAKE_CLIENTS=
ELEVENLABS_API_KEY=
JEV_API_KEY=
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-nano (cheapest). A stronger writer: gpt-5.4-mini.
OPENAI_MODEL=

# --- Agents (agents/): run `uv run --project agents python agents/scripts/gen_seeds.py`
# Seeds are fixed: an agent's address is derived from its seed, so never change them.
AGENTVERSE_URL=https://agentverse.ai
# 0: the front agent calls the analyzer's /analyze itself.
# 1: it chains Intake -> Signal Analyst -> Strategist (all four agents must be running).
FRONT_USE_SPECIALISTS=0

FRONT_AGENT_SEED=
FRONT_AGENT_ADDRESS=
FRONT_AGENT_PORT=8001

INTAKE_AGENT_SEED=
INTAKE_AGENT_ADDRESS=
INTAKE_AGENT_PORT=8002

ANALYST_AGENT_SEED=
ANALYST_AGENT_ADDRESS=
ANALYST_AGENT_PORT=8003

STRATEGIST_AGENT_SEED=
STRATEGIST_AGENT_ADDRESS=
STRATEGIST_AGENT_PORT=8004
